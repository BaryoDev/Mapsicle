<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Mapsicle.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for Mapsicle - Minimal API extensions, result mapping, and model binding</Description>
    <PackageTags>mapper;mapping;aspnetcore;minimalapi;automapper-alternative</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mapsicle.Fluent\Mapsicle.Fluent.csproj" />
    <ProjectReference Include="..\Mapsicle.Validation\Mapsicle.Validation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
