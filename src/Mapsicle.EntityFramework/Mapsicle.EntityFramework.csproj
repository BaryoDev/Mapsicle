<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Mapsicle.EntityFramework</PackageId>
    <Title>Mapsicle.EntityFramework</Title>
    <Description>Entity Framework Core integration for Mapsicle. Adds ProjectTo&lt;T&gt;() for IQueryable projections that translate to SQL.</Description>
    <PackageTags>mapper;efcore;entityframework;projection;queryable;sql;automapper-alternative</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mapsicle\Mapsicle.csproj" />
    <ProjectReference Include="..\Mapsicle.Fluent\Mapsicle.Fluent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

</Project>
