<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <PackageId>Mapsicle.DependencyInjection</PackageId>
    <Title>Mapsicle.DependencyInjection</Title>
    <Description>Registers Mapsicle in a Microsoft.Extensions.DependencyInjection container with no mapping configuration. Inject IMapperInstance and map by convention.</Description>
    <PackageTags>mapper;mapping;dependency-injection;di;automapper-alternative</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mapsicle\Mapsicle.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
