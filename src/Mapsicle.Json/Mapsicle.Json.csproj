<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Mapsicle.Json</PackageId>
    <Description>JSON serialization integration for Mapsicle - Map and serialize in one call with System.Text.Json support</Description>
    <PackageTags>mapper;mapping;json;serialization;automapper-alternative</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mapsicle.Fluent\Mapsicle.Fluent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>
